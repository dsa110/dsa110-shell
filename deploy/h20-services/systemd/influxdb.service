# InfluxDB 1.7.7 -- monitoring timeseries store, database "dsa110".
#
# Queried as influxdbservice.pro.pvt:8086 / lxd110h20.pro.pvt:8086.
# Written to by etcd2db (this host) and read by Grafana (this host).
#
# Adapted 2026-07-30 from RH's container-era unit: added
# Wants=network-online.target and dropped the ineffective pkill-based
# ExecStop/ExecReload (see etcdv3.service for the reasoning).
#
# Data lives on the ZFS pool: /dataz/influxdb/{meta,data,wal} (dataset
# dataz/influxdb, compression=lz4, atime=off) per influxdb.conf, owned by
# ubuntu since this runs as User=ubuntu.
#
# RequiresMountsFor is load-bearing, not decoration. If the dataz pool failed to
# import, /dataz would be an empty directory on the root disk -- influxd would
# happily create fresh meta/data/wal there and come up with an EMPTY database,
# silently losing every dashboard's history until someone noticed. This makes
# systemd refuse to start the unit unless the mount is actually present.

[Unit]
Description=Influx 1.7 Service
Documentation=man:influxdb
After=network-online.target zfs-mount.service
Wants=network-online.target
RequiresMountsFor=/dataz/influxdb

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu
ExecStart=/home/ubuntu/bin/startInfluxdb
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
