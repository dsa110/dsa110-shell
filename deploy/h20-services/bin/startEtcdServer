#!/bin/bash
#
# Single-node etcd v3 server for DSA-110, bare metal on lxd110h20.
#
# Rewritten 2026-07-30 during the h24 -> lxd110h20 promotion.  The original
# (container-era) version derived the listen address with
#
#     IP=`ifconfig | grep inet | grep broadcast | awk '{print $2}'`
#
# which returns exactly one address inside a single-NIC LXD container but
# THREE on this bare-metal host (br1 = pro/10.42, br2 = sas/10.41,
# docker0 = 172.17), producing an unusable --listen-client-urls and a
# daemon that refuses to start.  We now pin the management interface.
#
# Clients reach this via the DNS alias etcdv3service.pro.pvt (a CNAME to
# lxd110h20.pro.pvt), so we must listen on the pro/management address.
# We also listen on loopback so local tools (etcdctl, etcd2db, websrv)
# need no DNS and take no network hop.
#
set -eo pipefail

IFACE=br1                       # pro / management network (10.42.0.0/24)
ETCD=/home/ubuntu/proj/godev/src/github.com/etcd-io/etcd/bin/etcd
DATA=/home/ubuntu/etcd-data
NAME=dsa110-h20

IP=$(ip -4 -o addr show dev "$IFACE" 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -1)
if [ -z "$IP" ]; then
    echo "startEtcdServer: no IPv4 address on $IFACE; refusing to start" >&2
    exit 1
fi

mkdir -p "$DATA"
export ETCDCTL_API=3

# --auto-compaction-* is NOT optional here.  etcd defaults to NO auto
# compaction, so every update to a /mon key keeps its old revision forever.
# hwmc rewrites ~217 /mon/{ant,beb} points continuously (~35 revisions/s), so
# on 2026-07-31 the backend hit the 2 GiB default quota after roughly 18 hours,
# etcd raised a NOSPACE alarm and went READ-ONLY, and every writer in the
# observatory started failing with
#   grpc StatusCode.RESOURCE_EXHAUSTED "etcdserver: mvcc: database space exceeded"
# (antmc.service on antservice.ant.pvt was the first casualty).  Live data at
# the time was 0.16 MiB across 219 keys -- the other 2 GiB was pure history.
#
# Measured steady-state load (2026-07-31, all 217 mon points live): 217
# revisions/s -- one per point per second -- and the backend grows ~11.7 MiB per
# minute, i.e. ~700 MiB per hour of retained history.  So retention directly
# sets the steady-state DB size:
#     30m -> ~390k revisions, ~350 MiB      1h -> ~780k revisions, ~700 MiB
# 30m is the compromise: comfortably inside the quota, while still leaving a
# watcher half an hour to resync before it gets "required revision has been
# compacted".  That matters because etcd2db does NOT recover from a broken
# watch -- it keeps reporting active while silently forwarding nothing.
#
# NOTE: compaction reclaims space *logically*; the bbolt file never shrinks on
# its own.  It plateaus at the high-water mark, so an occasional
# `etcdctl defrag` (with --command-timeout well above the 5s default) is the
# only way to give the disk space back.
COMPACT_RETENTION=30m
QUOTA_BYTES=8589934592          # 8 GiB (default is 2 GiB)

# exec: replace the shell so systemd supervises etcd directly.  The original
# script trailed an `if [[ "$?" == 0 ]]; then while true; do sleep 60; done; fi`
# block, which meant a clean daemon exit left the wrapper sleeping forever --
# systemd reported the unit "active" while etcd was dead, and
# Restart=on-failure could never fire.
exec "$ETCD" \
    --name "$NAME" \
    --data-dir "$DATA" \
    --listen-client-urls "http://${IP}:2379,http://127.0.0.1:2379" \
    --advertise-client-urls "http://${IP}:2379" \
    --listen-peer-urls "http://${IP}:2380" \
    --initial-advertise-peer-urls "http://${IP}:2380" \
    --initial-cluster "${NAME}=http://${IP}:2380" \
    --initial-cluster-state new \
    --auto-compaction-mode periodic \
    --auto-compaction-retention "$COMPACT_RETENTION" \
    --quota-backend-bytes "$QUOTA_BYTES"
