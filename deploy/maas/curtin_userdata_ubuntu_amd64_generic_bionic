#
# Load snaps. Add additional snaps to end of the following python code.
# See: https://blackboxsw.github.io/seed-snaps-using-maas.html
write_files:
  modifynetplan:
    path: /var/lib/cloud/scripts/per-once/99_modifynetplan.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      #
      # modify netplan to not set default route on br2
      #
      echo "99_modifynetplan.sh: modifying netplan"
      sed -i -e '/mtu: 9000/ a \ \ \ \ \ \ \ \ \ \ \ \ dhcp4-overrides:\n\ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ use-routes: false' /etc/netplan/50-cloud-init.yaml
      echo "99_modifynetplan.sh: Finished modifying netplan"
  setubuntupwd:
    path: /var/lib/cloud/scripts/per-once/99_setubuntupwd.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      #
      # set ubuntu pwd
      #
      echo "99_setubuntupwd.sh: Setting ubuntu user's pwd"
      echo '__UBUNTU_PASSWORD__' | chpasswd
      echo "99_setubuntupwd.sh: Finished ubuntu user's pwd"
  startntp:
    path: /var/lib/cloud/scripts/per-once/99_startNTP.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      #
      # start NTP service
      #
      echo "Starting NTP service"
      systemctl start ntp
      echo "Finished Starting NTP service"
  mtu9000:
    path: /var/lib/cloud/scripts/per-once/99_mtu9000.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      #
      # change netplan's MTU values to 9000
      #
      echo "99_mtu9000.sh: Not installing new 50-cloud-init.yaml"
      exit 0
      
      WEB_MAAS="http://10.42.0.3/maas"
      echo "installing new netplan with proper MTU values"
      fn=lxd110h00-50-cloud-init.yaml
      wget $WEB_MAAS/config/lxd/$fn
      mv -f $fn /etc/netplan/50-cloud-init.yaml
      netplan apply
  tarballs:
    path: /var/lib/cloud/scripts/per-once/00_tarballs.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      #
      # install tarballs
      #
      WEB_MAAS="http://10.42.0.3/maas"
      echo "install_tarballs"
      wget $WEB_MAAS/config/lxd/install_tarballs
      chmod 755 install_tarballs
      ./install_tarballs
  dsarepos:
    path: /var/lib/cloud/scripts/per-once/00_clone_dsa_repos.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      #
      # clone dsa repos
      #
      #!/bin/bash
      #
      # clone dsa repos
      #
      WEB_MAAS="http://10.42.0.3/maas"
      echo "dsarepos"
      cd /home/ubuntu && wget $WEB_MAAS/config/homedirfiles/.mrtrust && wget $WEB_MAAS/config/homedirfiles/.gitconfig && wget $WEB_MAAS/config/homedirfiles/.gitignore
      mkdir -p /usr/local/bin && cd /usr/local/bin && wget $WEB_MAAS/config/homedirfiles/diff-highlight && chmod 755 diff-highlight
      mkdir -p /home/ubuntu/proj
      cd /home/ubuntu/proj && git clone https://github.com/dsa110/dsa110-shell.git
      cd dsa110-shell
      cp .mrconfig .mrconfig_ssh
      # modify existing .mrconfig option
      sed -i -e 's+git@github.com:+http\s\://github.com/+g' .mrconfig
      /usr/bin/mr -t checkout
      chown -R ubuntu:ubuntu /home/ubuntu
  anaconda3:
    path: /var/lib/cloud/scripts/per-once/00_anaconda3.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      #
      # install anaconda3
      #
      WEB_MAAS="http://10.42.0.3/maas"
      echo "installing anaconda3"
      fn=Anaconda3-2020.02-Linux-x86_64.sh
      cd /run && wget $WEB_MAAS/scripts/$fn && cd -
      if [[ ! -e /run/$fn ]]; then
          echo "/run/$fn does not exist. Bye"
      fi
      cd /home/ubuntu && bash /run/$fn -b -p /home/ubuntu/anaconda3 && cd -
      chown -R ubuntu:ubuntu /home/ubuntu
  lxd_install_service:
    path: /var/lib/cloud/scripts/per-once/00_0_lxd_install_service.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      #
      # Install LXD snap
      #
      echo "00_0_lxd_install_service.sh: installing snap lxd"
      snap install lxd
      count=0
      while($count -lt 10); do
         if [[ -e /snap/bin/lxd ]]; then
            echo "lxd installed"
            count=20
         fi
         count=$((count+1))
      done
      if [[ $count == 10 ]]; then
         echo "lxd failed to install"
      fi
  lxd_init_cluster:
    path: /var/lib/cloud/scripts/per-once/00_1_lxd_init_cluster.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      #
      # Modify lxd_cluster_node.yml file for specific hostname
      #
      WEB_MAAS="http://10.42.0.3/maas"
      echo "Running 00_1_lxd_init_cluster.sh"
      
      fn=lxd_node.yml
      iface=br2
      hn=`hostname`
      ip=`ip address show dev $iface | grep $iface | grep inet | awk '{print $2}' | awk -F '/' '{print $1}'`

      if [[ "$hn" == "" ]]; then
          echo "Could not obtain hostname. Bye"
          exit 1
      fi

      if [[ "$ip" == "" ]]; then
          echo "Could not obtain IP address. Bye"
          exit 1
      fi

      cd /run && wget $WEB_MAAS/config/lxd/$fn && cd -

      if [[ ! -e /run/$fn ]]; then
          echo "/run/$fn does not exist. Bye"
      fi
      # escape . to make sed happy.
      eip=${ip//"."/"\."}

      sed -i -e "s/THISHOST/$hn/g" /run/$fn
      sed -i -e "s/THISIP/$eip/g" /run/$fn
      sed -i -e "s/PASSWD/__LXD_TRUST_PASSWORD__/g" /run/$fn

      # remove hostname from /etc/hosts
      hnfq=`nslookup $hn | grep Name | awk '{print $2}'`
      if [[ "$hnfq" == "" ]]; then
         echo "hnfq empty. /etc/hosts unchanged"
         cat /etc/hosts
      else
         sed -i -e "s/$hnfq//" /etc/hosts
      fi

      # add snapcraft.io to /etc/hosts to prevent snap from updating lxd
      echo "127.0.0.1  api.snapcraft.io  api" >> /etc/hosts

      cat /run/$fn | /snap/bin/lxd init --preseed

      # if failed, then try contacting the main cluster node on its other
      # interface
      # if [[ $? -gt 0 ]]; then
      #    echo "pinging cluster host interface enp129s0f0.lxd110h00"
      #    ping -c3 enp129s0f0.lxd110h00
      #    sed -i -e "s/lxd110h00/enp129s0f0.lxd110h00/g" /run/$fn
      #    cat /run/$fn | /snap/bin/lxd init --preseed
      #    if [[ $? -gt 0 ]]; then
      #       echo "lxd cluster join failed. Is interface up?"
      #       echo "whomai: `whoami`"
      #       ping -c3 enp129s0f0.lxd110h00
      #    fi
      # fi
      
      # allow LXD to update database
      # sleep 60
  lxd_add_profile_corr:
    path: /var/lib/cloud/scripts/per-once/02_lxd_add_profile_corr.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      #
      # Add corr profile
      #
      WEB_MAAS="http://10.42.0.3/maas"
      echo "install lxd corr profile"
      hn=`hostname`
      corr_name=${hn//lxd110h/corr}
      fn=corrprofile.yaml
      cd /run && wget $WEB_MAAS/config/lxd/$fn && cd -
      if [[ ! -e /run/$fn ]]; then
          echo "/run/$fn does not exist. Bye"
      fi
      lxc profile create corr
      lxc profile edit corr < /run/$fn
  lxd_add_corr:
    path: /var/lib/cloud/scripts/per-once/03_lxd_add_corr.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      #
      # Add corr container
      #
      hn=`hostname`
      corr_name=${hn//lxd110h/corr}
      lxc launch ubuntu:16.04 $corr_name -p corr
      echo 'root:1000:1' >> /etc/subuid
      
      # Now add device to corr_name
      sleep 30
      echo "Configuring bind mount for $corr_name"
      lxc config set $corr_name raw.idmap 'both 1000 1000'
      lxc exec $corr_name -- mkdir -p /home/ubuntu/data
      lxc exec $corr_name -- chown ubuntu:ubuntu /home/ubuntu/data
      lxc config device add $corr_name ubuntu-data disk source=/home/ubuntu/data path=/home/ubuntu/data
      echo "Done configuring bind mount for $corr_name"
  sysctl:
    path: /var/lib/cloud/scripts/per-once/00_sysctl.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      #
      # Modify sysctl parameters
      #
      WEB_MAAS="http://10.42.0.3/maas"
      
      fn=set_sysctl
      cd /run && wget $WEB_MAAS/config/sysctl/$fn && cd -
      if [[ ! -e /run/$fn ]]; then
          echo "/run/$fn does not exist. Bye"
      fi
      # need to source the file, not execute it
      source /run/$fn
  cuda:
    path: /var/lib/cloud/scripts/per-once/00_install-cuda-1804.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      #
      # script to install cuda
      #
      echo "INSTALLING CUDA"
      WEB_MAAS="http://10.42.0.3/maas"

      echo "deleting default route to 10.41.0.4"
      route del default gw 10.41.0.4
      
      wget $WEB_MAAS/config/tarballs/cuda-ubuntu1804.pin
      mv cuda-ubuntu1804.pin /etc/apt/preferences.d/cuda-repository-pin-600
      wget $WEB_MAAS/config/tarballs/cuda-repo-ubuntu1804-11-1-local_11.1.0-455.23.05-1_amd64.deb
      dpkg -i cuda-repo-ubuntu1804-11-1-local_11.1.0-455.23.05-1_amd64.deb
      apt-key add /var/cuda-repo-ubuntu1804-11-1-local/7fa2af80.pub
      apt-get update
      apt-get -y install cuda
      nvidia-smi > /home/ubuntu/nvidia-smi.out
      echo "Finished Installing cuda"

