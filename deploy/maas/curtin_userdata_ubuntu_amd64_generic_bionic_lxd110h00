  dsarepos:
    path: /var/lib/cloud/scripts/per-once/00_clone_dsa_repos.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      #
      # clone dsa repos
      #
      WEB_MAAS="http://10.42.0.3/maas"
      echo "dsarepos"
      cd /home/ubuntu && wget $WEB_MAAS/config/homedirfiles/.mrtrust && wget $WEB_MAAS/config/homedirfiles/.gitconfig && wget $WEB_MAAS/config/homedirfiles/.gitignore
      mkdir -p /usr/local/bin && cd /usr/local/bin && wget $WEB_MAAS/config/homedirfiles/diff-highlight && chmod 755 diff-highlight
      mkdir -p /home/ubuntu/proj
      cd /home/ubuntu/proj && git clone https://github.com/dsa110/dsa110-shell.git
      cd dsa110-shell
      cp .mrconfig .mrconfig_ssh
      # modify existing .mrconfig option
      sed -i -e 's+git@github.com:+http\s\://github.com/+g' .mrconfig
      /usr/bin/mr -t checkout
      chown -R ubuntu:ubuntu /home/ubuntu
  anaconda3:
    path: /var/lib/cloud/scripts/per-once/00_anaconda3.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      #
      # install anaconda3
      #
      WEB_MAAS="http://10.42.0.3/maas"
