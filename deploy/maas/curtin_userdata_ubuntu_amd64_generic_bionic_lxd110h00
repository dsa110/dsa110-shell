  lxd_install_service:
    path: /var/lib/cloud/scripts/per-once/00_0_lxd_install_service.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      #
      # Install LXD snap
      #
      echo "00_0_lxd_install_service.sh: installing snap lxd"
      snap install lxd
      count=0
      while($count -lt 10); do
         if [[ -e /snap/bin/lxd ]]; then
            echo "lxd installed"
            count=20
         fi
         count=$((count+1))
      done
      if [[ $count == 10 ]]; then
         echo "lxd failed to install"
      fi
  lxd_init_cluster:
    path: /var/lib/cloud/scripts/per-once/00_1_lxd_init_cluster.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      #
      # Modify lxd_cluster_first_node.yml file for specific hostname
      #
      echo "00_1_lxd_init_cluster.sh Starting..."

      WEB_MAAS="http://10.42.0.3/maas"

      fn=lxd_cluster_first_node.yml
      iface=br2
      hn=`hostname`
      ip=`ip address show dev $iface | grep $iface | grep inet | awk '{print $2}' | awk -F '/' '{print $1}'`

      if [[ "$hn" == "" ]]; then
          echo "Could not obtain hostname. Bye"
          exit 1
      fi

      if [[ "$ip" == "" ]]; then
          echo "Could not obtain IP address. Bye"
          exit 1
      fi

      cd /run && wget $WEB_MAAS/config/lxd/$fn && cd -

      if [[ ! -e /run/$fn ]]; then
          echo "/run/$fn does not exist. Bye"
      fi

      sed -i -e "s/THISHOST/$hn/g" /run/$fn
      sed -i -e "s/THISIP/$ip/g" /run/$fn
      sed -i -e "s/PASSWD/__LXD_TRUST_PASSWORD__/g" /run/$fn

      # remove hostname from /etc/hosts
      hnfq=`nslookup $hn | grep Name | awk '{print $2}'`
      if [[ "$hnfq" == "" ]]; then
         echo "hnfq empty. /etc/hosts unchanged"
         cat /etc/hosts
      else
         sed -i -e "s/$hnfq//" /etc/hosts
      fi

      # add snapcraft.io to /etc/hosts to prevent snap from updating lxd
      echo "127.0.0.1  api.snapcraft.io  api" >> /etc/hosts
      
      cat /run/$fn | /snap/bin/lxd init --preseed
      # allow LXD to update database
      sleep 60
  lxd_install_cert:
    path: /var/lib/cloud/scripts/per-once/01_lxd_install_cert.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      #
      # Replace server crt for cluster.
      #
      WEB_MAAS="http://10.42.0.3/maas"
      echo "installing lxd cert"
      fncrt=server.crt
      fnkey=server.key
      path=/var/snap/lxd/common/lxd
      echo "Stopping lxd to insert certs"
      snap stop lxd
      rm -f $path/$fncrt
      rm -f $path/$fnkey
      cd $path && wget $WEB_MAAS/config/lxd/$fncrt && cd -
      cd $path && wget $WEB_MAAS/config/lxd/$fnkey && cd -      
      if [[ ! -e $path/$fncrt ]]; then
          echo "$path/$fncrt does not exist. trying one more time"
          sleep 10
          # echo "deleting extra default routes"
          route del default gw 10.42.0.4
          # echo "routes are: "
          route -n
          cd $path && wget $WEB_MAAS/config/lxd/$fncrt && cd -
      fi
      if [[ ! -e $path/$fnkey ]]; then
          echo "$path/$fnkey does not exist. trying one more time"
          sleep 10
          cd $path && wget $WEB_MAAS/config/lxd/$fnkey && cd -      
      fi
      if [[ ! -e $path/$fncrt ]]; then
          echo "$path/$fncrt does not exist. Container installs will fail"
      fi
      if [[ ! -e $path/$fnkey ]]; then
          echo "$path/$fnkey does not exist. Container installs will fail"
      fi
      chmod 600 $path/$fnkey
      snap start lxd
